---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import { doctor } from '../data/doctor.js';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: doctor.name,
  jobTitle: 'Doctor of Optometry',
  image: new URL(doctor.photo, site.url).href,
  url: `${site.url}/about`,
  alumniOf: doctor.education.map((e) => ({
    '@type': 'CollegeOrUniversity',
    name: e.school,
  })),
  worksFor: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  knowsAbout: doctor.specialties,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Dr. Fernandez', item: `${site.url}/about` },
  ],
};

const jsonLd = [personSchema, breadcrumbSchema];
---

<BaseLayout
  title="Meet Dr. Caron Fernandez, O.D."
  description="Meet Dr. Caron Fernandez, O.D., a Hilo optometrist practicing since 2008 and proudly independent since 2021. Comprehensive, pediatric, diabetic & dry eye care on the Big Island."
  jsonLd={jsonLd}
>
  <!-- Intro / header -->
  <section class="pt-32 pb-16 lg:pb-20 bg-sand-50 border-b border-slate-100 relative overflow-hidden">
    <div class="absolute -top-24 -right-32 w-96 h-96 bg-ocean-100/40 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="container-width relative">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <p class="eyebrow mb-4">Meet Your Doctor</p>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-slate-900 leading-[1.05] tracking-tight mb-5">
            Meet {doctor.name}
          </h1>
          <p class="text-lg text-slate-500 font-medium mb-6">{doctor.credential}</p>
          <p class="text-lg text-slate-600 leading-relaxed max-w-xl">
            A Hilo optometrist caring for the Big Island ʻohana since {doctor.sinceYear},
            and proudly running her own independent practice since {doctor.independentSince}.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-2 bg-white text-slate-700 px-4 py-2 rounded-full text-sm font-medium shadow-sm border border-slate-100">
              <Icon name="lucide:calendar-check" class="w-4 h-4 text-ocean-600" />
              Practicing since {doctor.sinceYear}
            </span>
            <span class="inline-flex items-center gap-2 bg-white text-slate-700 px-4 py-2 rounded-full text-sm font-medium shadow-sm border border-slate-100">
              <Icon name="lucide:shield-check" class="w-4 h-4 text-ocean-600" />
              Independent since {doctor.independentSince}
            </span>
            <span class="inline-flex items-center bg-white rounded-full px-4 py-2 shadow-sm border border-slate-100">
              <img
                src="/images/vision-source-member.png"
                alt="A Member of Vision Source"
                class="h-4 w-auto"
                width="200"
                height="22"
              />
            </span>
          </div>
        </div>

        <div class="relative reveal">
          <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-xl">
            <img
              src={doctor.photo}
              alt={`${doctor.name}, Doctor of Optometry at Eye Q Hawaii in Hilo`}
              class="w-full h-full object-cover"
              width="800"
              height="1000"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 glass-panel rounded-2xl p-6 max-w-[260px]">
            <div class="flex items-center gap-1 text-sand-500 mb-2" aria-hidden="true">
              {[1, 2, 3, 4, 5].map(() => <Icon name="lucide:star" class="w-4 h-4 fill-current" />)}
            </div>
            <p class="text-slate-600 text-sm italic">"Incredibly thorough and genuinely cares about her patients."</p>
            <p class="text-slate-400 text-xs mt-2">, Google Review</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bio + Education -->
  <section class="section-padding">
    <div class="container-width grid lg:grid-cols-3 gap-12 lg:gap-16">
      <!-- Bio -->
      <div class="lg:col-span-2 reveal">
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-slate-900 leading-tight mb-6">
          A doctor who knows her patients by name
        </h2>
        <div class="space-y-5">
          {doctor.bio.map((para) => (
            <p class="text-lg text-slate-600 leading-relaxed">{para}</p>
          ))}
        </div>

        <!-- Specialties -->
        <div class="mt-10">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400 mb-4">Areas of Focus</h3>
          <ul class="flex flex-wrap gap-3">
            {doctor.specialties.map((s) => (
              <li class="inline-flex items-center gap-2 text-sm bg-ocean-50 text-ocean-800 px-4 py-2 rounded-full font-medium">
                <Icon name="lucide:check" class="w-4 h-4 text-ocean-600" />
                {s}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Education timeline -->
      <aside class="reveal">
        <div class="bg-sand-50 rounded-3xl p-8 border border-slate-100 lg:sticky lg:top-28">
          <h2 class="font-display text-2xl font-semibold text-slate-900 mb-6 flex items-center gap-3">
            <Icon name="lucide:graduation-cap" class="w-6 h-6 text-ocean-600" />
            Education
          </h2>
          <ol class="relative border-l-2 border-ocean-100 ml-2 space-y-8">
            {doctor.education.map((e) => (
              <li class="pl-6 relative">
                <span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-ocean-500" aria-hidden="true"></span>
                <p class="font-semibold text-slate-900">{e.degree}</p>
                <p class="text-slate-600 text-sm mt-0.5">{e.school}</p>
                <p class="text-slate-400 text-sm">{e.location}</p>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative section-padding overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=1600&q=80"
        alt=""
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-slate-900/80"></div>
    </div>
    <div class="relative z-10 max-w-3xl mx-auto px-5 text-center reveal">
      <h2 class="font-display text-4xl lg:text-5xl font-semibold text-white leading-tight mb-6">
        See the difference personal care makes
      </h2>
      <p class="text-xl text-white/70 mb-10">
        Book a comprehensive eye exam with Dr. Fernandez in Hilo. Same-week appointments typically available.
      </p>
      <a href="/contact" class="btn-primary text-lg px-10 py-5 group">
        Book an Appointment
        <Icon name="lucide:arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
      </a>
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-8 text-white/60">
        <a href={site.phoneHref} class="flex items-center gap-2 hover:text-white transition">
          <Icon name="lucide:phone" class="w-5 h-5" /> {site.phone}
        </a>
        <span class="flex items-center gap-2"><Icon name="lucide:map-pin" class="w-5 h-5" /> Hilo, Hawaii</span>
      </div>
    </div>
  </section>
</BaseLayout>
