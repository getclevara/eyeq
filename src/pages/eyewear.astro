---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { brands } from '../data/content.js';

const HERO =
  'https://images.unsplash.com/photo-1502680390469-be75c86b636f?w=1600&q=80';

const valueProps = [
  {
    icon: 'lucide:sun',
    title: '100% UV Protection',
    desc: "Every pair blocks 100% of UVA and UVB rays, essential under Hawaii's intense island sun.",
  },
  {
    icon: 'lucide:waves',
    title: 'Polarized Lenses',
    desc: 'Cut glare off the water, sand, and roads for crisp, comfortable vision wherever the day takes you.',
  },
  {
    icon: 'lucide:eye',
    title: 'Prescription Available',
    desc: 'Nearly every frame and sunglass we carry can be made to your exact prescription, in-house.',
  },
];

const lifestyle = [
  {
    img: 'https://images.unsplash.com/photo-1502933691298-84fc14542831?w=1200&q=80',
    label: 'Surfing',
    alt: 'Surfer riding a wave off the Big Island coast',
  },
  {
    img: 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=1200&q=80',
    label: 'Hiking',
    alt: 'Hiker on a green volcanic trail in Hawaii',
  },
  {
    img: 'https://images.unsplash.com/photo-1473116763249-2faaef81ccda?w=1200&q=80',
    label: 'Beach Days',
    alt: 'Sunny Hawaiian beach with turquoise water and palm trees',
  },
  {
    img: 'https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=1200&q=80',
    label: 'On the Ocean',
    alt: 'Open ocean horizon under bright island sky',
  },
];

const featuredBrands = brands.filter((b) => b.featured);
const otherBrands = brands.filter((b) => !b.featured);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://eyeqhawaii.com/' },
      { '@type': 'ListItem', position: 2, name: 'Eyewear', item: 'https://eyeqhawaii.com/eyewear' },
    ],
  },
];
---

<BaseLayout
  title="Premium Eyewear & Designer Sunglasses in Hilo"
  description="Designer frames and polarized sunglasses in Hilo, Hawaii. Ray-Ban, Oakley & more, 100% UV protection, prescription available at Eye Q Hawaii's optical boutique."
  heroOverlay={true}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center">
    <div class="absolute inset-0">
      <img src={HERO} alt="Island surfer at golden hour wearing sunglasses on the Hawaiian coast" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/85 via-slate-900/60 to-slate-900/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 container-width py-32">
      <div class="max-w-2xl">
        <p class="eyebrow text-ocean-200 mb-5">The Optical Boutique</p>
        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-semibold text-white leading-[1.05] tracking-tight mb-6">
          Premium eyewear &amp; sunglasses,
          <span class="text-ocean-200"> made for island life</span>
        </h1>
        <p class="text-xl text-white/85 leading-relaxed mb-10 max-w-lg">
          Designer frames, polarized sunglasses, and precision prescription lenses, curated in Hilo and
          built to stand up to the Big Island sun.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn-primary text-base px-8 py-4 group">
            Visit the Boutique
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="/smart-glasses" class="border border-white/30 text-white px-8 py-4 rounded-full font-medium hover:bg-white/10 transition flex items-center justify-center gap-2">
            <Icon name="lucide:glasses" class="w-4 h-4" />
            Explore Smart Glasses
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Value props -->
  <section class="section-padding">
    <div class="container-width">
      <div class="max-w-2xl mb-14 reveal">
        <p class="eyebrow mb-4">Why Eye Q Hawaii</p>
        <h2 class="font-display text-4xl lg:text-5xl font-semibold text-slate-900 leading-tight">
          Protection and style, fitted by a doctor you trust
        </h2>
        <p class="text-lg text-slate-600 mt-6">
          Sunglasses on the Big Island are not an accessory, they are eye care. Every pair we sell is
          built to protect your vision while you live your island life.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {valueProps.map((v) => (
          <div class="bg-white rounded-2xl border border-slate-100 p-8 hover:shadow-xl hover:border-ocean-100 transition-all duration-300 reveal">
            <div class="w-12 h-12 rounded-xl bg-ocean-50 flex items-center justify-center mb-5">
              <Icon name={v.icon} class="w-6 h-6 text-ocean-600" />
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{v.title}</h3>
            <p class="text-slate-600">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brands strip -->
  <section class="section-padding bg-sand-50 border-y border-slate-100">
    <div class="container-width">
      <div class="max-w-2xl mb-12 reveal">
        <p class="eyebrow mb-4">The Brands We Carry</p>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-slate-900 leading-tight">
          Iconic frames, hand-picked for Hilo
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-6">
        {featuredBrands.map((b) => (
          <div class="reveal relative bg-slate-900 text-white rounded-2xl p-8 flex flex-col items-center justify-center text-center overflow-hidden">
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-ocean-500/20 rounded-full blur-2xl" aria-hidden="true"></div>
            <span class="relative font-display text-2xl font-semibold">{b.name}</span>
            <span class="relative mt-2 text-xs uppercase tracking-wider text-ocean-200">Featured</span>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {otherBrands.map((b) => (
          <div class="reveal bg-white border border-slate-100 rounded-2xl p-6 flex items-center justify-center text-center">
            <span class="font-display text-lg font-medium text-slate-700">{b.name}</span>
          </div>
        ))}
      </div>

      <p class="text-sm text-slate-500 mt-8 reveal">
        Looking for a brand you love that isn't listed? Ask us, our boutique selection rotates and we
        can often special-order.
      </p>
    </div>
  </section>

  <!-- Protect your vision in paradise, lifestyle grid -->
  <section class="section-padding">
    <div class="container-width">
      <div class="max-w-2xl mb-14 reveal">
        <p class="eyebrow mb-4">Protect Your Vision in Paradise</p>
        <h2 class="font-display text-4xl lg:text-5xl font-semibold text-slate-900 leading-tight">
          Built for every way you enjoy the Big Island
        </h2>
        <p class="text-lg text-slate-600 mt-6">
          From the lineup to the trailhead, we'll fit you with lenses tuned to how, and where, you
          spend your days.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {lifestyle.map((l) => (
          <div class="reveal group relative aspect-[3/4] rounded-2xl overflow-hidden">
            <img src={l.img} alt={l.alt} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <span class="font-display text-xl font-semibold text-white">{l.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Smart glasses callout -->
  <section class="section-padding bg-slate-900 text-white relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-ocean-500/20 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="container-width relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm font-medium mb-6">
            <Icon name="lucide:sparkles" class="w-4 h-4" />
            New · Wearable Tech
          </div>
          <h2 class="font-display text-4xl lg:text-5xl font-semibold leading-tight mb-6">
            Meet Oakley Meta smart glasses
          </h2>
          <p class="text-lg text-white/75 mb-8 leading-relaxed">
            Capture 3K video hands-free, take calls, and ask Meta AI anything, all from a pair of
            Oakley Prizm sunglasses. Prescription lenses available.
          </p>
          <a href="/smart-glasses" class="btn-primary text-base px-8 py-4 group">
            Explore Smart Glasses
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
        <div class="reveal">
          <div class="aspect-[4/3] rounded-3xl overflow-hidden bg-slate-800">
            <img src="/images/oakley-meta.png" alt="Oakley Meta smart glasses" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-width">
      <div class="relative overflow-hidden rounded-3xl bg-ocean-700 text-white px-8 py-16 lg:px-16 text-center reveal">
        <div class="absolute -top-20 -left-16 w-80 h-80 bg-white/10 rounded-full blur-3xl" aria-hidden="true"></div>
        <h2 class="relative font-display text-4xl lg:text-5xl font-semibold leading-tight mb-5">
          Find your perfect pair in Hilo
        </h2>
        <p class="relative text-xl text-white/85 max-w-2xl mx-auto mb-10">
          Stop by the boutique or book a styling and fitting appointment with Dr. Fernandez. We'll
          match you with frames and lenses that protect, perform, and look great.
        </p>
        <a href="/contact" class="relative inline-flex items-center gap-2 bg-white text-ocean-800 px-10 py-5 rounded-full font-semibold text-lg hover:bg-ocean-50 transition">
          Book an Appointment
          <Icon name="lucide:arrow-right" class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
