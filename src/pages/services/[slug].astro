---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.js';
import { services } from '../../data/services.js';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

// Branded gradient panels instead of stock photos (no stray portraits, fully on-brand).
const accents = [
  'from-ocean-500 via-ocean-600 to-ocean-800',
  'from-slate-700 via-slate-800 to-ocean-900',
  'from-ocean-600 via-ocean-700 to-slate-900',
];
const accent = accents[services.findIndex((s) => s.slug === service.slug) % accents.length];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.summary,
  serviceType: service.title,
  provider: {
    '@type': 'MedicalBusiness',
    name: site.name,
    telephone: site.phoneHref.replace('tel:', ''),
    address: {
      '@type': 'PostalAddress',
      addressLocality: site.address.locality,
      addressRegion: site.address.region,
      addressCountry: site.address.country,
    },
  },
  areaServed: [
    { '@type': 'Place', name: 'Hilo, Hawaii' },
    { '@type': 'Place', name: 'Big Island, Hawaii' },
  ],
  url: `${site.url}/services/${service.slug}`,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
    {
      '@type': 'ListItem',
      position: 3,
      name: service.title,
      item: `${site.url}/services/${service.slug}`,
    },
  ],
};

const jsonLd = [serviceSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title={`${service.title} in Hilo, HI`}
  description={service.seoDescription}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb + header -->
  <section class="relative overflow-hidden bg-gradient-to-b from-sand-50 to-white pt-32 pb-16 lg:pt-36 lg:pb-20">
    <div class="absolute -top-24 right-0 w-96 h-96 bg-ocean-100/40 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="container-width relative">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-ocean-600 transition">Home</a></li>
          <li aria-hidden="true"><Icon name="lucide:chevron-right" class="w-4 h-4 text-slate-300" /></li>
          <li><a href="/services" class="hover:text-ocean-600 transition">Services</a></li>
          <li aria-hidden="true"><Icon name="lucide:chevron-right" class="w-4 h-4 text-slate-300" /></li>
          <li class="text-slate-700 font-medium" aria-current="page">{service.title}</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <div class="w-14 h-14 rounded-2xl bg-ocean-50 flex items-center justify-center mb-6">
            <Icon name={service.icon} class="w-7 h-7 text-ocean-600" />
          </div>
          <h1 class="font-display text-4xl sm:text-5xl font-semibold text-slate-900 leading-[1.08] tracking-tight mb-6">
            {service.title}
          </h1>
          <p class="text-xl text-slate-600 leading-relaxed mb-8">{service.summary}</p>
          <div class="flex flex-wrap gap-3 mb-10">
            <span class="inline-flex items-center gap-2 text-sm bg-white border border-slate-200 text-slate-700 px-4 py-2 rounded-full">
              <Icon name="lucide:clock" class="w-4 h-4 text-ocean-600" />
              {service.duration}
            </span>
            <span class="inline-flex items-center gap-2 text-sm bg-white border border-slate-200 text-slate-700 px-4 py-2 rounded-full">
              <Icon name="lucide:users" class="w-4 h-4 text-ocean-600" />
              {service.forWho}
            </span>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="btn-primary text-base px-8 py-4 group">
              Book This Service
              <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
            <a href={site.phoneHref} class="btn-secondary text-base group">
              <Icon name="lucide:phone" class="w-4 h-4" />
              {site.phone}
            </a>
          </div>
        </div>

        <div class="reveal">
          <div class={`relative aspect-[4/3] rounded-3xl overflow-hidden shadow-xl bg-gradient-to-br ${accent}`}>
            <div class="absolute inset-0 opacity-[0.18]" style="background-image:radial-gradient(circle at center, white 1.4px, transparent 1.4px); background-size:22px 22px;" aria-hidden="true"></div>
            <div class="absolute -top-16 -right-16 w-64 h-64 bg-white/10 rounded-full blur-2xl" aria-hidden="true"></div>
            <Icon name={service.icon} class="absolute -bottom-8 -right-6 w-60 h-60 text-white/10" aria-hidden="true" />
            <div class="relative h-full flex flex-col items-start justify-end p-8">
              <div class="w-16 h-16 rounded-2xl bg-white/15 backdrop-blur-sm border border-white/25 flex items-center justify-center mb-4">
                <Icon name={service.icon} class="w-8 h-8 text-white" />
              </div>
              <div class="font-display text-2xl font-semibold text-white">{service.shortTitle}</div>
              <div class="text-white/60 text-sm mt-1">Eye Q Hawaii · Hilo, Big Island</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Description + What's included -->
  <section class="section-padding">
    <div class="container-width grid lg:grid-cols-5 gap-12 lg:gap-16">
      <div class="lg:col-span-3 reveal">
        <p class="eyebrow mb-4">Overview</p>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-slate-900 leading-tight mb-6">
          About {service.title}
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">{service.description}</p>
      </div>

      <div class="lg:col-span-2 reveal">
        <div class="bg-sand-50 rounded-3xl p-8 border border-sand-100">
          <h2 class="font-display text-2xl font-semibold text-slate-900 mb-6">What's included</h2>
          <ul class="space-y-4">
            {service.details.map((d) => (
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-ocean-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Icon name="lucide:check" class="w-3.5 h-3.5 text-white" />
                </span>
                <span class="text-slate-700">{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {service.slug === 'glasses-contacts' && (
    <section class="pb-2">
      <div class="container-width">
        <a href={site.orderContacts} target="_blank" rel="noopener noreferrer" class="group flex flex-col sm:flex-row sm:items-center justify-between gap-5 rounded-3xl bg-gradient-to-br from-ocean-600 to-ocean-800 text-white p-8 reveal">
          <div>
            <div class="inline-flex items-center gap-2 bg-white/15 border border-white/20 px-3 py-1 rounded-full text-xs font-medium mb-3">
              <Icon name="lucide:shopping-bag" class="w-3.5 h-3.5" />
              Existing patients
            </div>
            <h2 class="font-display text-2xl lg:text-3xl font-semibold">Already have a prescription? Order your contacts online.</h2>
            <p class="text-white/70 mt-1">Reorder your contact lenses anytime, shipped straight to your door.</p>
          </div>
          <span class="inline-flex items-center gap-2 bg-white text-slate-900 px-6 py-3.5 rounded-full font-semibold flex-shrink-0 group-hover:bg-white/90 transition">
            Order Contacts
            <Icon name="lucide:external-link" class="w-4 h-4" />
          </span>
        </a>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section-padding bg-slate-50">
    <div class="container-width max-w-3xl">
      <div class="text-center mb-12 reveal">
        <p class="eyebrow mb-4">Questions</p>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-slate-900 leading-tight">
          Frequently asked questions
        </h2>
      </div>
      <div class="space-y-4">
        {service.faqs.map((f) => (
          <details class="group bg-white rounded-2xl border border-slate-100 px-6 reveal">
            <summary class="flex items-center justify-between gap-4 cursor-pointer py-5 list-none font-semibold text-slate-900">
              {f.q}
              <Icon name="lucide:plus" class="w-5 h-5 text-ocean-600 flex-shrink-0 transition-transform group-open:rotate-45" />
            </summary>
            <p class="text-slate-600 leading-relaxed pb-6 -mt-1">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="section-padding">
    <div class="container-width">
      <div class="max-w-2xl mb-12 reveal">
        <p class="eyebrow mb-4">Explore More</p>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-slate-900 leading-tight">
          Related services
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {related.map((s) => (
          <a href={`/services/${s.slug}`} class="group bg-white rounded-2xl border border-slate-100 p-6 hover:shadow-xl hover:border-ocean-100 transition-all duration-300 reveal flex flex-col">
            <div class="w-12 h-12 rounded-xl bg-ocean-50 flex items-center justify-center group-hover:bg-ocean-500 transition-colors mb-4">
              <Icon name={s.icon} class="w-6 h-6 text-ocean-600 group-hover:text-white transition-colors" />
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{s.title}</h3>
            <p class="text-slate-600 text-sm flex-1">{s.summary}</p>
            <div class="mt-4 flex items-center text-ocean-600 text-sm font-medium">
              Learn more
              <Icon name="lucide:chevron-right" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 reveal">
        <a href="/services" class="btn-secondary group">
          View all services
          <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative section-padding overflow-hidden bg-slate-900 text-white">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-ocean-500/20 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-ocean-400/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="container-width relative text-center max-w-3xl mx-auto">
      <h2 class="font-display text-4xl lg:text-5xl font-semibold leading-tight mb-6">
        Ready to book your {service.shortTitle.toLowerCase()} visit?
      </h2>
      <p class="text-xl text-white/70 mb-10">
        Schedule with Dr. Fernandez in Hilo. Same-week appointments are typically available.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="btn-primary text-base px-8 py-4">Schedule an Appointment</a>
        <a href={site.phoneHref} class="border border-white/30 text-white px-8 py-4 rounded-full font-medium hover:bg-white/10 transition flex items-center justify-center gap-2">
          <Icon name="lucide:phone" class="w-4 h-4" />
          {site.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
