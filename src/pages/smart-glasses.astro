---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';

const features = [
  {
    icon: 'lucide:camera',
    title: '12MP Camera · 3K Video',
    desc: 'Capture ultra-wide photos and stabilized 3K video of every wave, hike, and sunset, completely hands-free.',
  },
  {
    icon: 'lucide:headphones',
    title: '8-Hour Battery',
    desc: 'All-day power for island adventures, plus a charging case that delivers up to 48 hours of additional use.',
  },
  {
    icon: 'lucide:droplets',
    title: 'IPX4 Water Resistant',
    desc: 'Splash- and sweat-resistant by design, ready for the surf, the trail, and the Hilo rain.',
  },
  {
    icon: 'lucide:message-square',
    title: 'Meta AI Built-In',
    desc: 'Ask questions, get directions, translate, and control playback with your voice, no phone in hand.',
  },
];

const chips = [
  'Prizm Lens Technology',
  'Garmin & Strava Integration',
  'Prescription Available',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Oakley Meta Smart Glasses',
    description:
      'Oakley Meta smart glasses combine Oakley Prizm lens technology with a 12MP camera, 3K hands-free video, open-ear audio, Meta AI, and IPX4 water resistance, available with prescription lenses at Eye Q Hawaii in Hilo.',
    image: 'https://eyeqhawaii.com/images/oakley-meta.png',
    brand: { '@type': 'Brand', name: 'Oakley' },
    category: 'Smart Glasses',
    offers: {
      '@type': 'Offer',
      price: '399',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://eyeqhawaii.com/smart-glasses',
      seller: { '@type': 'Organization', name: site.name },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://eyeqhawaii.com/' },
      { '@type': 'ListItem', position: 2, name: 'Smart Glasses', item: 'https://eyeqhawaii.com/smart-glasses' },
    ],
  },
];
---

<BaseLayout
  title="Oakley Meta Smart Glasses in Hilo"
  description="Oakley Meta smart glasses at Eye Q Hawaii in Hilo. 3K video, hands-free calls, Meta AI & Prizm lenses, prescription available. Starting at $399. Book a demo."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative bg-slate-900 text-white overflow-hidden pt-32 pb-20 lg:pb-28">
    <div class="absolute -top-24 -right-24 w-[28rem] h-[28rem] bg-ocean-500/20 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-ocean-400/10 rounded-full blur-3xl" aria-hidden="true"></div>

    <div class="container-width relative">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm font-medium mb-6">
            <Icon name="lucide:sparkles" class="w-4 h-4" />
            Oakley × Meta · Available at Eye Q Hawaii
          </div>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-semibold leading-[1.05] tracking-tight mb-6">
            Oakley Meta
            <span class="text-ocean-200"> Smart Glasses</span>
          </h1>
          <p class="text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
            Built for athletes and Hawaii adventures. Record 3K video, take hands-free calls, and tap
            into Meta AI, all from a pair of IPX4 water-resistant Oakley sunglasses with up to 8 hours
            of battery. Prescription lenses available.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="btn-primary text-base px-8 py-4 group">
              Book a Demo
              <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
            <a href={site.phoneHref} class="border border-white/30 text-white px-8 py-4 rounded-full font-medium hover:bg-white/10 transition flex items-center justify-center gap-2">
              <Icon name="lucide:phone" class="w-4 h-4" />
              {site.phone}
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-square rounded-3xl overflow-hidden bg-slate-800 border border-white/10">
            <img src="/images/oakley-meta.png" alt="Oakley Meta smart glasses with Prizm lenses" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature grid -->
  <section class="section-padding bg-slate-900 text-white border-t border-white/10">
    <div class="container-width">
      <div class="max-w-2xl mb-14 reveal">
        <p class="eyebrow text-ocean-300 mb-4">What They Do</p>
        <h2 class="font-display text-4xl lg:text-5xl font-semibold leading-tight">
          Technology that keeps up with island life
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {features.map((f) => (
          <div class="reveal bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/10 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-ocean-500/20 flex items-center justify-center mb-5">
              <Icon name={f.icon} class="w-6 h-6 text-ocean-300" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">{f.title}</h3>
            <p class="text-white/70">{f.desc}</p>
          </div>
        ))}
      </div>

      <!-- Feature chips -->
      <div class="mt-12 flex flex-wrap gap-3 reveal">
        {chips.map((c) => (
          <span class="inline-flex items-center gap-2 bg-white/5 border border-white/15 text-white/90 px-5 py-2.5 rounded-full text-sm font-medium">
            <Icon name="lucide:check" class="w-4 h-4 text-ocean-300" />
            {c}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Price card -->
  <section class="section-padding bg-slate-900 text-white">
    <div class="container-width">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-slate-800 to-slate-900 px-8 py-14 lg:px-16 reveal">
        <div class="absolute -top-20 -right-16 w-80 h-80 bg-ocean-500/20 rounded-full blur-3xl" aria-hidden="true"></div>
        <div class="relative grid lg:grid-cols-2 gap-10 items-center">
          <div>
            <p class="eyebrow text-ocean-300 mb-4">Pricing</p>
            <div class="font-display text-5xl lg:text-6xl font-semibold mb-3">
              Starting at $399
            </div>
            <p class="text-lg text-white/70">
              <span class="text-white/90">+ prescription lenses</span>, fitted and dispensed in-house
              by Dr. Fernandez. See and try a pair at our Hilo boutique before you buy.
            </p>
          </div>
          <div class="lg:text-right">
            <a href="/contact" class="btn-primary text-base px-8 py-4 group">
              Book a Demo
              <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
            <p class="text-sm text-white/50 mt-4">
              Prescription compatibility confirmed at your appointment.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
