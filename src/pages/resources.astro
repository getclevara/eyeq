---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import { lessons } from '../data/content.js';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Eye Health Resources & Patient Education, Eye Q Hawaii',
  itemListElement: lessons.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Article',
      headline: l.title,
      description: l.content,
      articleSection: l.category,
      url: `${site.url}/resources#${l.id}`,
    },
  })),
};

const jsonLd = [itemListSchema];
---

<BaseLayout
  title="Eye Health Resources & Patient Education"
  description="Plain-English guides on blue light, UV protection, contact lens care, and smart glasses from Eye Q Hawaii, eye care for Hilo and the Big Island."
  jsonLd={jsonLd}
>
  <!-- Header -->
  <section class="relative overflow-hidden bg-gradient-to-b from-sand-50 to-white pt-32 pb-14 lg:pt-40 lg:pb-16">
    <div class="absolute -top-24 right-0 w-96 h-96 bg-ocean-100/40 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="container-width relative">
      <div class="max-w-3xl reveal">
        <p class="eyebrow mb-4">Patient Education</p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-slate-900 leading-[1.05] tracking-tight mb-6">
          Eye Health Resources
        </h1>
        <p class="text-xl text-slate-600 leading-relaxed">
          Short, honest guides to help you take better care of your eyes, written for everyday life on
          the Big Island. From screen time and Hawaii's intense sun to contacts and smart glasses,
          here's what actually matters.
        </p>
      </div>
    </div>
  </section>

  <!-- Articles grid -->
  <section class="pb-20 lg:pb-28">
    <div class="container-width">
      <div class="grid md:grid-cols-2 gap-6">
        {lessons.map((l) => (
          <article id={l.id} class="bg-white rounded-2xl border border-slate-100 p-6 lg:p-8 hover:shadow-xl hover:border-ocean-100 transition-all duration-300 reveal flex flex-col scroll-mt-28">
            <div class="flex items-center justify-between gap-3 mb-5">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ocean-700 bg-ocean-50 px-3 py-1 rounded-full">
                <Icon name="lucide:tag" class="w-3.5 h-3.5" />
                {l.category}
              </span>
              <span class="inline-flex items-center gap-1.5 text-xs text-slate-400">
                <Icon name="lucide:clock" class="w-3.5 h-3.5" />
                {l.duration}
              </span>
            </div>

            <h2 class="font-display text-2xl font-semibold text-slate-900 leading-snug mb-3">
              {l.title}
            </h2>
            <p class="text-slate-600 leading-relaxed flex-1">{l.content}</p>

            <details class="group mt-5 border-t border-slate-100 pt-4">
              <summary class="flex items-center gap-2 cursor-pointer list-none text-sm font-medium text-ocean-600 hover:text-ocean-700 transition-colors">
                <span class="group-open:hidden">Read the key takeaways</span>
                <span class="hidden group-open:inline">Hide takeaways</span>
                <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" />
              </summary>
              <ol class="mt-4 space-y-3">
                {l.keyPoints.map((point, i) => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-6 h-6 rounded-full bg-ocean-50 text-ocean-700 text-xs font-semibold flex items-center justify-center mt-0.5">
                      {i + 1}
                    </span>
                    <span class="text-slate-600 leading-relaxed">{point}</span>
                  </li>
                ))}
              </ol>
            </details>
          </article>
        ))}
      </div>

      <!-- Disclaimer -->
      <div class="max-w-3xl mx-auto mt-12 reveal">
        <div class="flex items-start gap-4 rounded-2xl bg-sand-50 border border-sand-100 p-6">
          <Icon name="lucide:info" class="w-6 h-6 text-ocean-600 flex-shrink-0 mt-0.5" />
          <p class="text-slate-600 leading-relaxed">
            These guides are for general education only and are not medical advice or a diagnosis. Your
            eyes are unique, the best way to protect your vision is a comprehensive exam with
            Dr. Caron Fernandez, O.D. here in Hilo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative section-padding overflow-hidden bg-slate-900 text-white">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-ocean-500/20 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-ocean-400/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="container-width relative text-center max-w-3xl mx-auto">
      <h2 class="font-display text-4xl lg:text-5xl font-semibold leading-tight mb-6">
        Reading is great, an exam is better
      </h2>
      <p class="text-xl text-white/70 mb-10">
        Put these tips to work with a comprehensive eye exam tailored to you. Same-week appointments
        are typically available in Hilo.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="btn-primary text-base px-8 py-4">Book Your Eye Exam</a>
        <a href={site.phoneHref} class="border border-white/30 text-white px-8 py-4 rounded-full font-medium hover:bg-white/10 transition flex items-center justify-center gap-2">
          <Icon name="lucide:phone" class="w-4 h-4" />
          {site.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
