---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import { services } from '../data/services.js';
import { doctor } from '../data/doctor.js';
import { brands } from '../data/content.js';

// Brands beyond the three featured retail cards (Oakley Meta, Ray-Ban, Oakley).
const otherBrands = brands.filter((b) => !b.featured).map((b) => b.name);

const HERO =
  'https://images.unsplash.com/photo-1483168527879-c66136b56105?w=1600&q=80';

const stats = [
  { value: '2008', label: 'Caring for Hawaii since' },
  { value: '1k+', label: 'Patients served' },
  { value: '5.0', label: 'Google rating' },
];

const trust = [
  { icon: 'lucide:shield-check', title: 'Doctor-Owned', desc: 'Independent practice since 2021' },
  { icon: 'lucide:zap', title: 'Advanced Technology', desc: 'Latest diagnostic equipment' },
  { icon: 'lucide:users', title: 'Family Practice', desc: 'Keiki to kūpuna, all ages' },
  { icon: 'lucide:award', title: 'Vision Source Member', desc: 'Trusted independent network' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
];
---

<BaseLayout heroOverlay={true} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative min-h-screen">
    <div class="absolute inset-0">
      <img src={HERO} alt="Sunset over the Big Island coastline" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/85 via-slate-900/55 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 min-h-screen flex items-center">
      <div class="container-width py-24">
        <div class="max-w-2xl">
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white/90 px-4 py-2 rounded-full text-sm font-medium border border-white/20">
              <Icon name="lucide:map-pin" class="w-4 h-4" />
              Hilo, Big Island
            </span>
            <span class="inline-flex items-center bg-white rounded-full px-4 py-2 shadow-sm">
              <img src="/images/vision-source-member.png" alt="A Member of Vision Source" class="h-4 w-auto" width="200" height="22" />
            </span>
          </div>

          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-semibold text-white leading-[1.05] tracking-tight mb-6">
            Sharper Vision.
            <br />
            <span class="text-ocean-200">Smarter Care.</span>
          </h1>

          <p class="text-xl text-white/80 leading-relaxed mb-10 max-w-lg">
            Where advanced eye care meets aloha spirit. Hilo's destination for comprehensive vision
            services, premium eyewear, and genuinely personal attention.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={site.orderContacts} target="_blank" rel="noopener noreferrer" class="btn-primary text-base px-8 py-4">
              <Icon name="lucide:shopping-bag" class="w-4 h-4" />
              Order Contacts
            </a>
            <a href={site.payOnline} target="_blank" rel="noopener noreferrer" class="border border-white/40 bg-white/5 text-white px-8 py-4 rounded-full font-semibold hover:bg-white/15 transition flex items-center justify-center gap-2">
              <Icon name="lucide:credit-card" class="w-4 h-4" />
              Pay Online
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-6 text-sm">
            <a href="/contact" class="text-white/80 hover:text-white transition inline-flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="w-4 h-4" />
              New patient? Request an appointment
            </a>
            <span class="text-white/30" aria-hidden="true">·</span>
            <a href="/vision-test" class="text-white/80 hover:text-white transition inline-flex items-center gap-1.5">
              <Icon name="lucide:eye" class="w-4 h-4" />
              Free vision test
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 z-10">
      <div class="container-width">
        <div class="bg-white/10 backdrop-blur-md rounded-t-2xl border border-white/20 border-b-0">
          <div class="grid grid-cols-3 divide-x divide-white/20">
            {stats.map((s) => (
              <div class="py-6 px-4 sm:px-8 text-center">
                <div class="font-display text-2xl sm:text-3xl font-semibold text-white">{s.value}</div>
                <div class="text-xs sm:text-sm text-white/60 mt-1">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="py-9 bg-sand-50 border-b border-slate-100">
    <div class="container-width grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-10">
      {trust.map((t) => (
        <div class="flex items-start gap-4 reveal">
          <div class="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center flex-shrink-0">
            <Icon name={t.icon} class="w-5 h-5 text-ocean-600" />
          </div>
          <div>
            <div class="font-semibold text-slate-900">{t.title}</div>
            <div class="text-sm text-slate-500 mt-0.5">{t.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="section-padding">
    <div class="container-width">
      <div class="max-w-2xl mb-10 reveal">
        <p class="eyebrow mb-3">Our Services</p>
        <h2 class="font-display text-4xl lg:text-5xl font-semibold text-slate-900 leading-tight">
          Comprehensive vision care for the whole ʻohana
        </h2>
        <p class="text-lg text-slate-600 mt-6">
          From routine exams to specialized treatment, we provide complete eye care for every age and need.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <a href={`/services/${s.slug}`} class="group bg-white rounded-2xl border border-slate-100 p-6 hover:shadow-xl hover:border-ocean-100 transition-all duration-300 reveal flex flex-col">
            <div class="flex items-start justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-ocean-50 flex items-center justify-center group-hover:bg-ocean-500 transition-colors">
                <Icon name={s.icon} class="w-6 h-6 text-ocean-600 group-hover:text-white transition-colors" />
              </div>
              <span class="text-xs text-slate-400 bg-slate-50 px-2.5 py-1 rounded-full">{s.duration}</span>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{s.title}</h3>
            <p class="text-slate-600 text-sm flex-1">{s.summary}</p>
            <div class="mt-4 flex items-center text-ocean-600 text-sm font-medium">
              Learn more
              <Icon name="lucide:chevron-right" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Retail / Brands -->
  <section id="retail" class="section-padding bg-sand-50 border-y border-sand-100">
    <div class="container-width">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8 reveal">
        <div class="max-w-xl">
          <p class="eyebrow mb-3">The Optical Boutique</p>
          <h2 class="font-display text-4xl lg:text-5xl font-semibold text-slate-900 leading-[1.05]">
            Premium eyewear &amp; smart glasses
          </h2>
        </div>
        <a href="/eyewear" class="btn-secondary group self-start md:self-auto">
          Shop the collection
          <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid lg:grid-cols-3 gap-5">
        <!-- Oakley Meta hero card -->
        <a href="/smart-glasses" class="group lg:col-span-2 relative overflow-hidden rounded-3xl bg-slate-900 text-white reveal min-h-[340px] flex">
          <img src="/images/oakley-meta.png" alt="Oakley Meta smart glasses" class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
          <div class="relative mt-auto p-8">
            <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs font-medium mb-4">
              <Icon name="lucide:sparkles" class="w-3.5 h-3.5" />
              New · Performance AI Glasses
            </div>
            <h3 class="font-display text-3xl font-semibold mb-2">Oakley Meta</h3>
            <p class="text-white/70 max-w-md mb-4">Capture your adventures in 3K, take calls hands-free, and get Meta AI on the trail. In your prescription.</p>
            <span class="inline-flex items-center gap-2 text-white font-medium">
              Explore smart glasses
              <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </span>
          </div>
        </a>

        <!-- Ray-Ban + Oakley stack -->
        <div class="grid gap-5">
          <a href="/eyewear" class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-ocean-600 to-ocean-800 text-white p-7 reveal flex flex-col justify-between min-h-[160px]">
            <Icon name="lucide:glasses" class="w-10 h-10 text-white/30 group-hover:text-white/50 transition-colors" />
            <div>
              <div class="font-display text-2xl font-semibold">Ray-Ban</div>
              <div class="text-white/70 text-sm mt-1">Icons, Wayfarers &amp; Aviators</div>
            </div>
          </a>
          <a href="/eyewear" class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-800 to-slate-900 text-white p-7 reveal flex flex-col justify-between min-h-[160px]">
            <Icon name="lucide:sun" class="w-10 h-10 text-white/30 group-hover:text-white/50 transition-colors" />
            <div>
              <div class="font-display text-2xl font-semibold">Oakley</div>
              <div class="text-white/70 text-sm mt-1">Prizm performance sunglasses</div>
            </div>
          </a>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 reveal">
        <span class="text-sm text-slate-400 uppercase tracking-[0.18em] font-semibold">Also featuring</span>
        {otherBrands.map((b) => (
          <span class="font-display text-lg text-slate-500">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Vision Test teaser (differentiator) -->
  <section class="section-padding bg-slate-900 text-white relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-ocean-500/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-ocean-400/10 rounded-full blur-3xl"></div>
    <div class="container-width relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm font-medium mb-6">
            <Icon name="lucide:sparkles" class="w-4 h-4" />
            Free · No sign-up
          </div>
          <h2 class="font-display text-4xl lg:text-5xl font-semibold leading-tight mb-6">
            Check your vision in minutes, right from home
          </h2>
          <p class="text-lg text-white/70 mb-8 leading-relaxed">
            Our free online vision screening walks you through acuity, color vision, astigmatism, and
            more. It's a quick, modern way to see if it's time for an exam.
            <span class="text-white/50"> A screening, not a diagnosis. A comprehensive exam with Dr. Fernandez is still essential.</span>
          </p>
          <a href="/vision-test" class="btn-primary text-base px-8 py-4 group">
            Start the Vision Test
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 reveal">
          {[
            { icon: 'lucide:eye', label: 'Visual Acuity' },
            { icon: 'lucide:palette', label: 'Color Vision' },
            { icon: 'lucide:asterisk', label: 'Astigmatism' },
            { icon: 'lucide:grid-3x3', label: 'Amsler Grid' },
          ].map((m) => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
              <Icon name={m.icon} class="w-7 h-7 text-ocean-300 mb-3" />
              <div class="font-medium">{m.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="section-padding">
    <div class="container-width grid lg:grid-cols-2 gap-16 items-center">
      <div class="relative reveal">
        <div class="aspect-[4/5] rounded-3xl overflow-hidden">
          <img src={doctor.photo} alt={`${doctor.name}, Optometrist at Eye Q Hawaii`} class="w-full h-full object-cover" />
        </div>
        <div class="absolute -bottom-6 -right-6 glass-panel rounded-2xl p-6 max-w-[240px]">
          <div class="flex items-center gap-1 text-sand-500 mb-2">
            {[1, 2, 3, 4, 5].map(() => <Icon name="lucide:star" class="w-4 h-4 fill-current" />)}
          </div>
          <p class="text-slate-600 text-sm italic">"Incredibly thorough and genuinely cares about her patients."</p>
          <p class="text-slate-400 text-xs mt-2">, Google Review</p>
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow mb-4">Meet Your Doctor</p>
        <h2 class="font-display text-4xl lg:text-5xl font-semibold text-slate-900 leading-tight mb-4">{doctor.name}</h2>
        <p class="text-slate-500 mb-6 font-medium">{doctor.credential}</p>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">{doctor.bio[0]}</p>
        <p class="text-lg text-slate-600 leading-relaxed">{doctor.bio[1]}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {doctor.specialties.map((s) => (
            <span class="text-sm bg-sand-100 text-slate-700 px-4 py-2 rounded-full">{s}</span>
          ))}
        </div>
        <a href="/about" class="btn-secondary mt-8 group">
          More about Dr. Fernandez
          <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative section-padding overflow-hidden bg-gradient-to-br from-slate-900 via-slate-900 to-ocean-900">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute -top-24 -right-20 w-96 h-96 bg-ocean-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-28 -left-20 w-96 h-96 bg-ocean-400/10 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 opacity-[0.05]" style="background-image:radial-gradient(circle at center, white 1.4px, transparent 1.4px); background-size:26px 26px;"></div>
    </div>
    <div class="relative z-10 max-w-3xl mx-auto px-5 text-center">
      <h2 class="font-display text-4xl lg:text-5xl font-semibold text-white leading-tight mb-6">Everything you need, in one place</h2>
      <p class="text-xl text-white/70 mb-10">Reorder your contacts, pay your bill, or take a quick vision test, all online and on your time.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={site.orderContacts} target="_blank" rel="noopener noreferrer" class="btn-primary text-base px-8 py-4">
          <Icon name="lucide:shopping-bag" class="w-4 h-4" />
          Order Contacts
        </a>
        <a href={site.payOnline} target="_blank" rel="noopener noreferrer" class="border border-white/40 bg-white/5 text-white px-8 py-4 rounded-full font-semibold hover:bg-white/15 transition flex items-center justify-center gap-2">
          <Icon name="lucide:credit-card" class="w-4 h-4" />
          Pay Online
        </a>
      </div>
      <p class="mt-6 text-white/70 text-sm">
        New patient? <a href="/contact" class="text-white font-medium underline underline-offset-4 hover:text-ocean-200 transition">Request an appointment</a>
      </p>
      <div class="mt-14 flex flex-col sm:flex-row items-center justify-center gap-8 text-white/60">
        <a href={site.phoneHref} class="flex items-center gap-2 hover:text-white transition">
          <Icon name="lucide:phone" class="w-5 h-5" /> {site.phone}
        </a>
        <span class="flex items-center gap-2"><Icon name="lucide:map-pin" class="w-5 h-5" /> Hilo, Hawaii</span>
        <span class="flex items-center gap-2"><Icon name="lucide:clock" class="w-5 h-5" /> {site.hoursLabel}</span>
      </div>
    </div>
  </section>
</BaseLayout>
